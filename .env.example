# First-party Contact API endpoint. Leave empty until the health endpoint is deployed.
# When empty or unhealthy, the contact page uses the verified Google Form and email paths.
VITE_CONTACT_ENDPOINT=

# Public site URL used for canonical and post-submit redirect
VITE_SITE_URL=https://www.regalocom.net

# Optional Cloudflare Web Analytics site token (public, not a secret).
# When empty, no analytics beacon is loaded.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
